{
  "name": "dsh-mistral-pro",
  "version": "0.6.1",
  "description": "Mistral subscription (Vibe Pro/Team) provider for DeepSeek Harness: multi-account failover, model catalog, sidebar usage card, statistics panel and settings page.",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "main": "./index.js",
  "scripts": {
    "test": "node test/run.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/adapter.js && node --check lib/config.js && node --check lib/catalog.js && node --check lib/transport.js && node --check lib/wire.js && node --check lib/usage.js && node --check lib/accounts.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.ja.md",
    "docs/images/*.png",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mistral",
    "mistral-ai",
    "mistral-vibe",
    "vibe-pro",
    "llm",
    "llm-provider",
    "model-provider",
    "prompt-caching",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "author": "01NGVI-QINGYI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordraiden/dsh-mistral-pro.git"
  },
  "homepage": "https://github.com/lordraiden/dsh-mistral-pro#readme",
  "bugs": {
    "url": "https://github.com/lordraiden/dsh-mistral-pro/issues"
  }
}
